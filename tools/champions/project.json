{
	"name": "champions",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "tools/champions/src",
	"projectType": "library",
	"tags": [],
	"targets": {
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "tools/champions/jest.config.ts"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"fetch": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ts-node --project tools/champions/tsconfig.lib.json tools/champions/src/cli.ts fetch"
			}
		},
		"roster": {
			"executor": "nx:run-commands",
			"options": {
				"command": "ts-node --project tools/champions/tsconfig.lib.json tools/champions/src/cli.ts roster"
			}
		}
	}
}
